  player: {fileID: 2028898520}
  subtitles: {fileID: 155546813}
  boat: {fileID: 428756095}
  departureOffset: {x: -24, y: 0, z: -20}
  departureSeconds: 8
  warnings:
  - speaker: Boatman
    text: Crane's missed three weeks of calls. Could be the set. Could be worse.
    clip: {fileID: 0}
    duration: 4
  - speaker: Boatman
    text: "Light the lamp before dark. And if you hear singing\u2014don't answer it."
    clip: {fileID: 0}
    duration: 4
  - speaker: Daniel
    text: When do you come back?
    clip: {fileID: 0}
    duration: 4
  - speaker: Boatman
    text: Morning. If the light's on.
    clip: {fileID: 0}
    duration: 4
  finaleMode: 1
