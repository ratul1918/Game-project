    duration: 4
  - speaker: Boatman
    text: "Light the lamp before dark. And if you hear singing\u2014don't answer it."
    clip: {fileID: 0}
    duration: 4
  - speaker: Daniel
    text: When do you come back?
    clip: {fileID: 0}
    duration: 4
  - speaker: Boatman
    text: Morning. If the light's on.
    clip: {fileID: 0}
    duration: 4
  finaleMode: 1
