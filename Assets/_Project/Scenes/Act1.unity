  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TheLightHouse.Boatman
  player: {fileID: 316949910}
  subtitles: {fileID: 2129459699}
  boat: {fileID: 1754518273}
  departureOffset: {x: -5, y: 0, z: -35}
  departureSeconds: 12
  audioSource: {fileID: 0}
  line1Clip: {fileID: 0}
  line2Clip: {fileID: 0}
  warnings:
  - speaker: Boatman
    text: Crane's missed three weeks of calls. Could be the set. Could be worse.
    clip: {fileID: 0}
    duration: 4
  - speaker: Boatman
    text: "Light the lamp before dark. And if you hear singing\u2014don't answer it."
    clip: {fileID: 0}
    duration: 4
  - speaker: Daniel
    text: When do you come back?
    clip: {fileID: 0}
    duration: 4
  - speaker: Boatman
    text: Morning. If the light's on.
    clip: {fileID: 0}
    duration: 4
  finaleMode: 0
