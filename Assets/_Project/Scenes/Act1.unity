  m_GameObject: {fileID: 1365941857}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 66cb56eaa318e45a590872837b5f53fe, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TheLightHouse.Boatman
  player: {fileID: 658541349}
  subtitles: {fileID: 498913229}
  boat: {fileID: 716821189}
  departureOffset: {x: -24, y: 0, z: -20}
  departureSeconds: 12
  warnings:
  - speaker: Boatman
    text: Crane's missed three weeks of calls. Could be the set. Could be worse.
    clip: {fileID: 0}
    duration: 4
  - speaker: Boatman
    text: "Light the lamp before dark. And if you hear singing\u2014don't answer it."
    clip: {fileID: 0}
    duration: 4
  - speaker: Daniel
    text: When do you come back?
    clip: {fileID: 0}
    duration: 4
  - speaker: Boatman
    text: Morning. If the light's on.
    clip: {fileID: 0}
    duration: 4
  finaleMode: 0
